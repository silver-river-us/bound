# Bound architecture contracts are language-neutral.
architecture Commerce {
  context Orders {
    implementation go "example.com/commerce/internal/orders"
    exposes OrderPort
  }

  context Customers {
    implementation go "example.com/commerce/internal/customers"
    exposes CustomerPort
  }

  context Web {
    implementation go "example.com/commerce/internal/web"
  }

  context App {
    implementation go "example.com/commerce/cmd/commerce"
  }

  Web -> Orders via OrderPort
  Web -> Customers via CustomerPort
  App -> Web
}
