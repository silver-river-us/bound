"""
Commerce is a small modular monolith. The composition root wires adapters
to application-facing ports; domain contexts do not reach into one another.
"""
architecture Commerce do
  import "commerce/commerce.bom"

  """
  Orders owns the lifecycle and invariants of an order.
  """
  context Orders do
    implementation go "./internal/orders"
    """
    The port is the public contract that other contexts may depend on.
    """
    interface OrderPort do
      """
      Place creates an order after the caller has authenticated the customer.
      """
      operation Place(orderID string, amount int) Order
    end
    exposes OrderPort
  end

  context Customers do
    implementation go "./internal/customers"
    interface CustomerPort do
      operation Find(customerID string) Customer
    end
    exposes CustomerPort
  end

  context Web do
    implementation go "./internal/web"
  end

  context App do
    implementation go "./cmd/commerce"
  end

  """
  Web coordinates the user-facing use case and may consume only declared ports.
  """
  Web -> Orders via OrderPort
  Web -> Customers via CustomerPort
  App -> Web
  App -> Orders
  App -> Customers
end
