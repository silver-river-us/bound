"""
Commerce is a small modular monolith. The composition root wires adapters
to application-facing ports; domain contexts do not reach into one another.
"""
architecture Commerce do
  implementation go "./"
  import "commerce/commerce.go.bom"

  """
  Orders owns the lifecycle and invariants of an order.
  """
  context Orders do
    """
    The port is the public contract that other contexts may depend on.
    """
    interface OrderPort do
      entity Order do
        state :id :string
        state :amount :int
      end

      """
      Place creates an order after the caller has authenticated the customer.
      """
      behavior Place(orderID string, amount int) returns Order
    end
    exposes OrderPort

    module Internal do
      module Orders do
        implements OrderPort
      end
    end
  end

  context Customers do
    interface CustomerPort do
      entity Customer do
        state :id :string
        state :email :string
      end

      behavior Find(customerID string) returns Customer
    end
    exposes CustomerPort

    module Internal do
      module Customers do
        implements CustomerPort
      end
    end
  end

  context Web do
    interface Checkout do
      behavior checkout(customerID string, orderID string, amount int) returns string
    end
    exposes Checkout

    module Internal do
      module Web do
        implements Checkout
        uses Orders.OrderPort
        uses Customers.CustomerPort
      end
    end
  end

  context App do
    module Cmd do
      module Commerce do
        entrypoint Commerce
        uses Orders.OrderPort
        uses Customers.CustomerPort
        uses Web.Checkout
      end
    end
  end

  """
  Web coordinates the user-facing use case and may consume only declared ports.
  """
  Web -> Orders via OrderPort
  Web -> Customers via CustomerPort
  App -> Web via Checkout
  App -> Orders via OrderPort
  App -> Customers via CustomerPort
end
