"""
The daily report is an executable architecture: it discovers organizations,
collects activity through declared ports, and renders a human-facing report.
The Go program is only one implementation of these contracts.
"""
architecture GitHubDaily do
  import "github-daily.go.bom"

  module GithubActivity do
    implementation go "./daily_reporting/github_activity"
  end

  module GithubActivity.GitHub do
    implementation go "./daily_reporting/github_activity/github"
  end

  module DailyReport do
    implementation go "./daily_reporting/daily_report"
  end

  module DailyReport.Command do
    implementation go "./daily_reporting/daily_report/cmd/github-daily"
  end

  entity Organization do
    state :login :string
  end

  value Activity do
    state :source :string
    state :actor :string
    state :repository :string
    state :occurred_at :timestamp
  end

  context DailyReporting do
    implementation go "./"

    """
    Reads the activity sources available to the authenticated GitHub user.
    """
    interface GithubActivity do
      behavior organizations() returns Organization[]
      behavior activity(organization, timeWindow) returns Activity[]
    end
    exposes GithubActivity

    """
    Produces the daily report and its summary.
    """
    interface DailyReport do
      behavior render(organizations, activities, warnings)
    end
    exposes DailyReport
  end

end
