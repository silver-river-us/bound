"""
The daily report is an executable architecture: it discovers organizations,
collects activity through declared ports, and renders a human-facing report.
The Go program is only one implementation of these contracts.
"""
architecture GitHubDaily do
  import "github-daily.bom"

  object Organization do
    attribute :login :string
  end

  object Activity do
    attribute :source :string
    attribute :actor :string
    attribute :repository :string
    attribute :occurred_at :timestamp
  end

  context DailyReporting do
    implementation go "./"

    """
    Reads the activity sources available to the authenticated GitHub user.
    """
    interface GitHubActivity do
      operation organizations() returns Organization[]
      operation activity(organization, timeWindow) returns Activity[]
    end
    exposes GitHubActivity

    """
    Produces the daily report and its summary.
    """
    interface DailyReport do
      operation render(organizations, activities, warnings)
    end
    exposes DailyReport
  end

end
