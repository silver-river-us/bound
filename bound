#!/usr/bin/env bash
set -euo pipefail

export ASDF_GOLANG_MOD_VERSION_ENABLED=true

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
bound_binary="$repo_root/target/go/bound"
go_command="go"
if command -v asdf >/dev/null 2>&1; then
  go_command="$(asdf which go)"
fi

mkdir -p "$repo_root/target/go"
(cd "$repo_root" && "$go_command" build -trimpath -o "$bound_binary" ./src)
exec "$bound_binary" "$@"
